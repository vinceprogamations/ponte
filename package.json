{
  "name": "ponte",
  "productName": "Ponte",
  "version": "2.2.0",
  "description": "Chat, voz e compartilhamento de tela direto pela LAN / Radmin VPN, sem servidor.",
  "author": "vinceprogamations",
  "license": "MIT",
  "homepage": "https://github.com/vinceprogamations/ponte",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinceprogamations/ponte.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/privacy.test.js test/private-link.test.js test/privacy-network.test.js test/history-sync.test.js && node test/lan.test.js",
    "test:electron": "node test/electron-privacy.cjs",
    "icon": "electron scripts/make-icon.js",
    "dist": "npm run native && electron-builder --win nsis --publish never",
    "native": "node scripts/build-native.js"
  },
  "build": {
    "appId": "io.github.vinceprogamations.ponte",
    "productName": "Ponte",
    "copyright": "MIT · vinceprogamations",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vinceprogamations",
        "repo": "ponte",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ponte",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Ponte-Instalar.exe"
    },
    "extraResources": [
      {
        "from": "native/bin/ponte-audio.exe",
        "to": "ponte-audio.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "selfsigned": "5.5.0"
  }
}
